# The sibling checkouts `.github/workflows/play.yml` builds against.
#
# `Cargo.toml` names rinch and rhypedb by path, `../rinch-fixes` and
# `../rhypedb-main`, and a GitHub runner has no neighbouring directories — so
# the workflow clones each one beside this repo at the commit named here.
# Written by `scripts/pin-siblings.sh`, which refuses a commit the runner could
# not fetch; only the KEY=value lines are read.
RINCH_REPO=lost-conn/rinch
RINCH_REV=8ee352f24ff7edf01288bba9f85b3dee1c2dd0f1
RHYPEDB_REPO=joeleaver/rhypedb
RHYPEDB_REV=cd7e198630ca7fe8a83058240b0cb71b2716a9d9
