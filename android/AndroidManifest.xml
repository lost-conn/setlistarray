<?xml version="1.0" encoding="utf-8"?>
<!--
  SetListArray is offline-first: no account, no sync, nothing uploaded.

  There are therefore NO <uses-permission> elements here, and there should
  never be one for camera, location or network. Everything the app stores goes
  into app-private storage (`AndroidApp::internal_data_path()`), which needs no
  permission; attachments are imported through the system file picker, which
  grants access per file without one either. Asking for a permission this app
  does not need would be a bug, not an oversight.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.lostconnection.setlistarray"
    android:versionCode="1"
    android:versionName="0.1.0">

    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="35" />

    <application
        android:label="SetListArray"
        android:hasCode="true"
        android:allowBackup="false">

        <!--
          NativeActivity subclass from rinch-android: it loads the .so, owns the
          surface, and exposes the platform services (IME, insets) over JNI.
        -->
        <activity
            android:name="com.rinch.RinchActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize">

            <meta-data
                android:name="android.app.lib_name"
                android:value="setlistarray" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
