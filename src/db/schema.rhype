// SetListArray, schema v1.
//
// Everything except a song's title, artist and created_at is optional — the
// handoff is explicit that unfilled metadata is absent, never a placeholder.
// rhypedb lets a field simply not be set, which is exactly that.
//
// Two notes for anyone editing:
//
// 1. An edge-field block must come BEFORE any directive on the same field.
//    `songs: [Song] { position: u32 } @on_delete(remove)` parses; putting the
//    block after the directive does not.
//
// 2. An @on_delete policy is applied to the relations pointing AT the object
//    being deleted, and it acts on the SOURCE of those relations. So the
//    policy that takes an attachment with its song has to live on the
//    attachment's own `song` field, not on the song's `attachments` list —
//    written the other way round it means "deleting a chart deletes the song",
//    which is how schema v1 had it. `Setlist.songs @on_delete(remove)` reads
//    correctly under the same rule: deleting a Song is what removes it from
//    every set.

type Attachment {
    // Pdf | CapturedPage | Text
    kind: String
    title: String
    bytes_on_disk: u64
    page_count: u32
    source_url: String
    captured_at: DateTime
    // Extracted text, for typed attachments and for searching captures.
    body: String
    // The song this chart belongs to. See note 2 above for why the cascade
    // lives here rather than on `Song.attachments`.
    song: Song @on_delete(cascade)
}

type Song {
    title: String
    artist: String
    // `key` on its own reads as a reserved word in too many places; the UI
    // still calls it the key.
    song_key: String
    tempo: u32
    tuning: String
    capo: u32
    // Seconds.
    duration: u32
    // Comma-separated; there are only ever a handful per song and no query
    // needs to filter on them server-side.
    tags: String
    // Solid | Rusty | Learning. Absent means unrated.
    confidence: String
    notes: String
    last_played: DateTime
    created_at: DateTime
    // The first attachment added becomes the primary one.
    primary_attachment: u64
    attachments: [Attachment] @inverse(Attachment.song)
    setlists: [Setlist] @inverse(Setlist.songs)
}

type Setlist {
    name: String
    last_played: DateTime
    created_at: DateTime
    // Membership is by reference and ordered: `position` is the running order,
    // and removing a song from a set never touches the song.
    songs: [Song] {
        position: u32
    } @on_delete(remove)
}
